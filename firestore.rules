rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The Raspberry Pi writes with the Firebase Admin SDK, which bypasses
    // these rules. The Android app only needs read access.
    //
    // This allows public reads so the app works without authentication.
    // Add Firebase Auth and tighten `allow read` before collecting anything
    // sensitive (for example equipment control).
    match /sensors/{sensorId} {
      allow read: if true;
      allow write: if false;

      match /measurements/{measurementId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Alerts are published by the Pi and read by the app. Clients cannot
    // create or modify them.
    match /alerts/{alertId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
